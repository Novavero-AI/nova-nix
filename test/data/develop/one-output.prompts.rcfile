[ -n "$PS1" ] && [ -e ~/.bashrc ] && source ~/.bashrc;
shopt -u expand_aliases
unset shellHook
PATH=${PATH:-}
nix_saved_PATH="$PATH"
XDG_DATA_DIRS=${XDG_DATA_DIRS:-}
nix_saved_XDG_DATA_DIRS="$XDG_DATA_DIRS"
BASH='/nix/store/3fyf1d1h6cdg8gc7pjpnh1hxkm5a4mmv-bash-5.3p3/bin/bash'
HOSTTYPE='aarch64'
IFS=' 	
'
IN_NIX_SHELL='impure'
export IN_NIX_SHELL
LINENO='78'
MACHTYPE='aarch64-apple-darwin25.4.0'
NIX_BUILD_CORES='4'
export NIX_BUILD_CORES
NIX_CFLAGS_COMPILE='-I/home/user/project/outputs/out/include -DGREETING="hello world"'
export NIX_CFLAGS_COMPILE
NIX_STORE='/nix/store'
export NIX_STORE
OLDPWD=''
export OLDPWD
OPTERR='1'
OSTYPE='darwin25.4.0'
PATH='/nix/store/4zd8mb1c7r0x5jsg2dqhlf9wnv6pyk3a-hello-dep-1.0/bin:/nix/store/3fyf1d1h6cdg8gc7pjpnh1hxkm5a4mmv-bash-5.3p3/bin'
export PATH
PS4='+ '
SHELL='/noshell'
export SHELL
buildInputs='/nix/store/4zd8mb1c7r0x5jsg2dqhlf9wnv6pyk3a-hello-dep-1.0'
export buildInputs
builder='/nix/store/3fyf1d1h6cdg8gc7pjpnh1hxkm5a4mmv-bash-5.3p3/bin/bash'
export builder
dontAddDisableDepTrack='1'
export dontAddDisableDepTrack
empty=''
export empty
declare -a envHostHostHooks=()
declare -A fixtureFlags=(['newline']='a
b' ['plain']='tab	here' ['with space']='it'\''s' )
multiline='line one
line two'
export multiline
name='hello-env'
export name
out='/home/user/project/outputs/out'
export out
outputs='out'
export outputs
declare -a preBuildHooks=('echo "before build"' 'echo it'\''s' )
prefix='/home/user/project/outputs/out'
quoted='it'\''s a "quoted" \backslash'
export quoted
shellHook='echo "Entering $name in $PWD"
export FIXTURE_HOOK_RAN=1'
export shellHook
stdenv='/nix/store/2wn1qbk9i4ydbvqgmrbx3hx3k1l0vjfh-stdenv'
export stdenv
system='x86_64-linux'
export system
tabbed='a	b'
export tabbed
buildPhase ()
{
 
    runHook preBuild;
    echo "building into $out with $NIX_CFLAGS_COMPILE";
    make -j"$NIX_BUILD_CORES" PREFIX="$out";
    runHook postBuild
}
genericBuild ()
{
 
    for curPhase in ${phases:-buildPhase};
    do
        runPhase "$curPhase";
    done
}
runHook ()
{
 
    local hookName="$1";
    shift;
    local hooksSlice="${hookName%Hook}Hooks[@]";
    local hook;
    for hook in ${!hooksSlice+"${!hooksSlice}"};
    do
        eval "$hook" "$@";
    done;
    if declare -F "$hookName" > /dev/null; then
        "$hookName" "$@";
    else
        if [ -n "${!hookName:-}" ]; then
            eval "${!hookName}";
        fi;
    fi;
    return 0
}
runPhase ()
{
 
    local curPhase="$*";
    echo "Running phase: $curPhase";
    runHook "pre${curPhase^}";
    eval "${!curPhase:-$curPhase}"
}
PATH="$PATH${nix_saved_PATH:+:$nix_saved_PATH}"
XDG_DATA_DIRS="$XDG_DATA_DIRS${nix_saved_XDG_DATA_DIRS:+:$nix_saved_XDG_DATA_DIRS}"
export NIX_BUILD_TOP="$(mktemp -d -t nix-shell.XXXXXX)"
export TMP="$NIX_BUILD_TOP"
export TMPDIR="$NIX_BUILD_TOP"
export TEMP="$NIX_BUILD_TOP"
export TEMPDIR="$NIX_BUILD_TOP"
eval "${shellHook:-}"
command rm -f '/tmp/nix-shell.Xc9Tq2'

shopt -s expand_aliases
[ -n "$PS1" ] && PS1='\[\e[1;32m\]dev\$ ';
[ -n "$PS1" ] && PS1='(nix) '"$PS1";
[ -n "$PS1" ] && PS1+=' it'\''s';
SHELL="bash"
