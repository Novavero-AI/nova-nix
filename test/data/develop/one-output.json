{
  "bashFunctions": {
    "buildPhase":" \n    runHook preBuild;\n    echo \"building into $out with $NIX_CFLAGS_COMPILE\";\n    make -j\"$NIX_BUILD_CORES\" PREFIX=\"$out\";\n    runHook postBuild\n",
    "genericBuild":" \n    for curPhase in ${phases:-buildPhase};\n    do\n        runPhase \"$curPhase\";\n    done\n",
    "runHook":" \n    local hookName=\"$1\";\n    shift;\n    local hooksSlice=\"${hookName%Hook}Hooks[@]\";\n    local hook;\n    for hook in ${!hooksSlice+\"${!hooksSlice}\"};\n    do\n        eval \"$hook\" \"$@\";\n    done;\n    if declare -F \"$hookName\" > /dev/null; then\n        \"$hookName\" \"$@\";\n    else\n        if [ -n \"${!hookName:-}\" ]; then\n            eval \"${!hookName}\";\n        fi;\n    fi;\n    return 0\n",
    "runPhase":" \n    local curPhase=\"$*\";\n    echo \"Running phase: $curPhase\";\n    runHook \"pre${curPhase^}\";\n    eval \"${!curPhase:-$curPhase}\"\n"
  },
